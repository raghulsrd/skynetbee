<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Hidato - Privacy Policy</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Arial, sans-serif;
            color: white;

            background:
                radial-gradient(
                    circle at 15% 20%,
                    rgba(0, 255, 200, 0.12),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 85% 25%,
                    rgba(150, 70, 255, 0.14),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 50% 90%,
                    rgba(255, 50, 150, 0.10),
                    transparent 35%
                ),
                #050812;
        }

        .container {
            width: 92%;
            max-width: 850px;
            margin: 35px auto;
        }

        /* HIDATO HEADER */

        .header {
            text-align: center;
            margin-bottom: 25px;
        }

        .logo {
            font-size: 46px;
            font-weight: 900;
            letter-spacing: 5px;

            background: linear-gradient(
                90deg,
                #00ffd5,
                #8d5cff,
                #ff4fa3
            );

            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;

            text-shadow:
                0 0 20px rgba(0, 255, 213, 0.25);
        }

        .tagline {
            color: #9ca7b8;
            font-size: 14px;
            margin-top: 5px;
        }

        /* MAIN GLASS CARD */

        .main-card {
            padding: 28px;

            background: rgba(12, 18, 32, 0.72);

            border: 1px solid rgba(255, 255, 255, 0.10);

            border-radius: 28px;

            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);

            box-shadow:
                0 20px 60px rgba(0, 0, 0, 0.45),
                0 0 35px rgba(0, 255, 213, 0.04);
        }

        h1 {
            text-align: center;
            font-size: 28px;
            margin: 0 0 28px 0;
        }

        /* SECTIONS */

        .section {
            margin-bottom: 16px;
            padding: 20px;

            background: rgba(255, 255, 255, 0.045);

            border: 1px solid rgba(255, 255, 255, 0.08);

            border-radius: 18px;

            transition: 0.25s;
        }

        .section:hover {
            border-color: rgba(0, 255, 213, 0.25);

            box-shadow:
                0 0 20px rgba(0, 255, 213, 0.06);
        }

        h2 {
            margin: 0 0 9px 0;

            font-size: 19px;

            background: linear-gradient(
                90deg,
                #00ffd5,
                #a06cff
            );

            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        p {
            margin: 0;

            color: #c5cedb;

            font-size: 15px;

            line-height: 1.7;
        }

        /* FOOTER */

        .footer {
            text-align: center;

            margin-top: 25px;

            color: #697587;

            font-size: 12px;
        }

        .footer span {
            color: #00ffd5;
        }

        /* MOBILE */

        @media (max-width: 600px) {

            .container {
                width: 94%;
                margin: 20px auto;
            }

            .main-card {
                padding: 20px;
                border-radius: 22px;
            }

            .logo {
                font-size: 36px;
                letter-spacing: 4px;
            }

            h1 {
                font-size: 24px;
            }

            .section {
                padding: 17px;
            }

            h2 {
                font-size: 18px;
            }

            p {
                font-size: 14px;
            }
        }
    </style>

</head>

<body>

    <div class="container">

        <!-- HIDATO HEADER -->

        <div class="header">

            <div class="logo">
                HIDATO
            </div>

            <div class="tagline">
                Think • Connect • Complete
            </div>

        </div>


        <!-- MAIN PRIVACY POLICY CARD -->

        <div class="main-card">

            <h1>
                Privacy Policy
            </h1>


            <!-- PRIVACY -->

            <div class="section">

                <h2>
                    Privacy at Hidato
                </h2>

                <p>
                    Hidato respects your privacy. This Privacy Policy explains
                    how the Hidato application handles user information.
                </p>

            </div>


            <!-- INFORMATION WE COLLECT -->

            <div class="section">

                <h2>
                    Information We Collect
                </h2>

                <p>
                    Hidato does not collect, store, or share personal information
                    such as your name, email address, phone number, or location.
                </p>

            </div>


            <!-- LOCAL DATA -->

            <div class="section">

                <h2>
                    Local Data
                </h2>

                <p>
                    The app may store game progress, levels, and scores locally
                    on your device to provide the app's features.
                </p>

            </div>


            <!-- THIRD PARTY -->

            <div class="section">

                <h2>
                    Third-Party Services
                </h2>

                <p>
                    Hidato does not use third-party services to collect personal
                    information.
                </p>

            </div>


            <!-- CHILDREN -->

            <div class="section">

                <h2>
                    Children's Privacy
                </h2>

                <p>
                    Hidato does not knowingly collect personal information from
                    children.
                </p>

            </div>


            <!-- DATA SECURITY -->

            <div class="section">

                <h2>
                    Data Security
                </h2>

                <p>
                    Since personal information is not collected by the app,
                    there is no personal information transmitted to our servers.
                </p>

            </div>


            <!-- CHANGES -->

            <div class="section">

                <h2>
                    Changes to This Policy
                </h2>

                <p>
                    This Privacy Policy may be updated from time to time.
                    Any changes will be reflected on this page.
                </p>

            </div>


            <!-- CONTACT -->

            <div class="section">

                <h2>
                    Contact
                </h2>

                <p>
                    If you have any questions about this Privacy Policy,
                    please contact the developer of Hidato.
                </p>

            </div>


            <!-- COPYRIGHT -->

            <div class="footer">

                © <span>SkynetBee Private Limited</span>.
                All Rights Reserved.

            </div>

        </div>

    </div>

</body>

</html>
